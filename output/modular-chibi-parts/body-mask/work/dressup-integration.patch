 import { OrbitControls } from "three/addons/controls/OrbitControls.js";
 import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
 
+import { BODY_REGIONS } from "./config.js";
+
+export function getBodyRegions(scene) {
+  const regions = new Map();
+  let skeleton;
+  scene.traverse(node => {
+    if (!node.isSkinnedMesh) return;
+    if (!BODY_REGIONS.includes(node.name) || regions.has(node.name))
+      throw new Error(`Invalid body region: ${node.name}`);
+    if (skeleton && node.skeleton !== skeleton) throw new Error("Body has multiple skeletons");
+    skeleton = node.skeleton;
+    regions.set(node.name, node);
+    node.frustumCulled = false;
+  });
+  if (regions.size !== BODY_REGIONS.length) throw new Error("Body is missing regions");
+  return { regions, skeleton };
+}
+
+export function applyBodyMask(regions, wornModules) {
+  const references = new Map();
+  for (const { hides = [] } of wornModules) {
+    for (const region of hides) references.set(region, (references.get(region) ?? 0) + 1);
+  }
+  for (const [region, mesh] of regions) mesh.visible = !references.has(region);
+}
