{
  "name": "blender-3d-gallery",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run validate:assets && vite build",
    "build:deploy": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "validate:assets": "node scripts/validate-assets.mjs && node models/gjh-chibi-visitor/validate.mjs && node models/pomelo-stem/mascot/validate.mjs && node models/drive/validate.mjs && node models/city/validate.mjs && node models/commerce-hub/validate.mjs",
    "test": "node scripts/check-i18n.mjs && node scripts/check-color-tokens.mjs && node scripts/check-palette-contrast.mjs && node --test tests/*.test.mjs",
    "test:browser": "node scripts/test-game-browser.mjs && node scripts/test-game-experience.mjs",
    "test:pwa": "node scripts/test-pwa-browser.mjs",
    "test:solar": "node scripts/test-solar-assets.mjs",
    "test:library": "node scripts/test-library-browser.mjs && node scripts/test-viewer-context-cleanup.mjs",
    "test:standard": "node scripts/test-pwa-standard.mjs",
    "test:reviewed": "node scripts/test-reviewed-bugs.mjs",
    "test:game-ux": "node scripts/test-game-ux.mjs",
    "test:game-experience": "node scripts/test-game-experience.mjs",
    "test:game-responsive": "node scripts/test-game-responsive.mjs",
    "test:dressup": "node scripts/test-chibi-dressup-browser.mjs",
    "test:drive": "node scripts/test-drive-browser.mjs",
    "test:city": "node scripts/test-city-browser.mjs",
    "test:cans": "node scripts/test-gjh-can-visual.mjs",
    "test:cans:codex": "node scripts/test-gjh-can-visual.mjs --codex",
    "test:world": "node --test scripts/world/world-network.test.mjs scripts/world/fort-canning-tunnel.test.mjs scripts/world/fort-canning-integration.test.mjs scripts/world/fort-canning-merge-alignment.test.mjs scripts/world/fort-canning-junction.test.mjs scripts/world/fort-canning-runtime-overlay.test.mjs scripts/world/raffles-boulevard-passage.test.mjs scripts/world/marina-square-passage.test.mjs scripts/world/temasek-boulevard.test.mjs scripts/world/raffles-link-passage.test.mjs && node scripts/world/mission-distances.mjs --check",
    "test:openworld": "node scripts/test-world-browser.mjs",
    "test:raffles-passage": "node scripts/test-world-raffles-browser.mjs",
    "test:raffles-link-passage": "node scripts/test-world-raffles-link-browser.mjs",
    "test:marina-square-passage": "node scripts/test-world-marina-square-browser.mjs",
    "test:temasek-passages": "node scripts/test-world-temasek-browser.mjs",
    "test:world-ambient-access": "node scripts/test-world-ambient-access-browser.mjs",
    "test:world-tile-queue": "node scripts/test-world-tile-queue-browser.mjs",
    "test:streamed-tunnel": "node scripts/test-world-streamed-tunnel-browser.mjs",
    "test:tunnel": "node scripts/test-world-tunnel-browser.mjs",
    "test:mrt": "node scripts/test-mrt-browser.mjs",
    "test:commerce": "node scripts/test-commerce-hub-browser.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright": "1.64.1",
    "vite": "8.3.5"
  }
}
