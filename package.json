{
  "name": "blender-3d-gallery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run validate:assets && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "validate:assets": "node scripts/validate-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/test-game-browser.mjs",
    "test:pwa": "node scripts/test-pwa-browser.mjs",
    "test:solar": "node scripts/test-solar-assets.mjs",
    "test:library": "node scripts/test-library-browser.mjs",
    "test:standard": "node scripts/test-pwa-standard.mjs",
    "test:reviewed": "node scripts/test-reviewed-bugs.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright": "1.64.1",
    "vite": "8.3.5"
  }
}
